#! /bin/bash

dir="${1:-.}"

find "$dir" -type f \
! -path "*/node_modules/*" \
! -path "*/.git/*" \
! -path "*/.next/*" \
! -path "*/*.css*" \
! -path "*/components/ui/*" \
! -path "*/lib/utils.ts" \
| while read -r file; do
    # Check if file is UTF-8 text
    if file "$file" | grep -q 'text'; then

        # 1. This prints to the Console (Stderr)
        echo "Processing: ${file#$dir/}" >&2

        # 2. This prints to file.txt (Stdout)
        echo "// ${file#$dir/}"
        cat "$file"
    fi
done
